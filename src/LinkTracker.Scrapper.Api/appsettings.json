{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Rest": {
        "Url": "http://0.0.0.0:8081",
        "Protocols": "Http1"
      },
      "GRPC": {
        "Url": "http://0.0.0.0:8082",
        "Protocols": "Http2"
      }
    }
  },
  "Bot": {
    "BaseUrl": "http://localhost:8091",
    "Transport": "Http"
  },
  "Scheduling": {
    "IntervalSeconds": 30,
    "BatchSize": 100,
    "MaxDegreeOfParallelism": 4
  },
  "GitHub": {
    "BaseUrl": "https://api.github.com"
  },
  "StackOverflow": {
    "BaseUrl": "https://api.stackexchange.com"
  },
  "Database": {
    "Host": "localhost",
    "Port": 5434,
    "Name": "linktracker",
    "User": "postgres",
    "Password": "postgres",
    "AccessType": "Orm",
    "MigrationsPath": "../../migrations",
    "RunMigrations": true
  },
  "Kafka": {
    "BootstrapServers": "localhost:9094,localhost:9095,localhost:9096",
    "Topic": "link-updates",
    "Serialization": "Avro",
    "SchemaRegistryUrl": "http://localhost:8071"
  },
  "Outbox": {
    "Enabled": true,
    "DispatchIntervalSeconds": 10,
    "BatchSize": 100,
    "MaxRetryCount": 3,
    "LockSeconds": 60
  },
  "Valkey": {
    "Enabled": true,
    "ConnectionString": "localhost:7379,localhost:7380,localhost:7381,password=valkey,abortConnect=false",
    "InstanceName": "linktracker",
    "LinksTtlSeconds": 60,
    "ClientSideCachingEnabled": true,
    "ClientSideCacheTtlSeconds": 10,
    "ClientSideCacheMaxEntries": 1000
  },
  "Resilience": {
    "Http": {
      "TimeoutMilliseconds": 1000,
      "Retry": {
        "MaxRetryAttempts": 2,
        "BackoffMilliseconds": 200,
        "BackoffStrategy": "Constant",
        "RetryableStatusCodes": [
          408,
          429,
          500,
          502,
          503,
          504
        ]
      },
      "CircuitBreaker": {
        "FailureRateThreshold": 100,
        "SamplingDurationSeconds": 10,
        "MinimumThroughput": 5,
        "WaitDurationInOpenStateMilliseconds": 1000
      }
    }
  },
  "RateLimiting": {
    "PermitLimit": 10,
    "WindowSeconds": 60,
    "SegmentsPerWindow": 6,
    "QueueLimit": 0
  }
}
