{
  "Kestrel": {
    "Endpoints": {
      "Metrics": {
        "Url": "http://0.0.0.0:8011",
        "Protocols": "Http1"
      }
    }
  },
  "Scrapper": {
    "BaseUrl": "http://scrapper:8082",
    "Transport": "Grpc"
  },
  "Kafka": {
    "BootstrapServers": "kafka-1:9092,kafka-2:9092,kafka-3:9092",
    "Topic": "link.processed-updates",
    "GroupId": "linktracker-bot",
    "DeadLetterTopic": "link-updates-dlq",
    "RetryAttempts": 3,
    "RetryBackoffMilliseconds": 500,
    "Serialization": "Json",
    "SchemaRegistryUrl": "http://schema-registry:8071"
  },
  "Resilience": {
    "Http": {
      "TimeoutMilliseconds": 1000,
      "Retry": {
        "MaxRetryAttempts": 2,
        "BackoffMilliseconds": 200,
        "BackoffStrategy": "Constant",
        "RetryableStatusCodes": [
          408,
          429,
          500,
          502,
          503,
          504
        ]
      },
      "CircuitBreaker": {
        "FailureRateThreshold": 100,
        "SamplingDurationSeconds": 10,
        "MinimumThroughput": 5,
        "WaitDurationInOpenStateMilliseconds": 1000
      }
    }
  },
  "RateLimiting": {
    "PermitLimit": 10,
    "WindowSeconds": 60,
    "SegmentsPerWindow": 6,
    "QueueLimit": 0
  }
}
