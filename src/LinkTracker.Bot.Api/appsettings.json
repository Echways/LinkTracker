{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Rest": {
        "Url": "http://0.0.0.0:8091",
        "Protocols": "Http1"
      },
      "GRPC": {
        "Url": "http://0.0.0.0:8092",
        "Protocols": "Http2"
      },
      "Metrics": {
        "Url": "http://0.0.0.0:8011",
        "Protocols": "Http1"
      }
    }
  },
  "Scrapper": {
    "BaseUrl": "http://localhost:8082",
    "Transport": "Grpc"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9094,localhost:9095,localhost:9096",
    "Topic": "link.processed-updates",
    "GroupId": "linktracker-bot",
    "DeadLetterTopic": "link.processed-updates-dlq",
    "RetryAttempts": 3,
    "RetryBackoffMilliseconds": 500,
    "Serialization": "Json",
    "SchemaRegistryUrl": "http://localhost:8071"
  },
  "Valkey": {
    "Enabled": true,
    "ConnectionString": "localhost:7379,localhost:7380,localhost:7381,password=valkey",
    "InstanceName": "linktracker",
    "DialogTtlSeconds": 3600
  },
  "Resilience": {
    "Http": {
      "TimeoutMilliseconds": 1000,
      "Retry": {
        "MaxRetryAttempts": 2,
        "BackoffMilliseconds": 200,
        "BackoffStrategy": "Constant",
        "RetryableStatusCodes": [
          408,
          429,
          500,
          502,
          503,
          504
        ]
      },
      "CircuitBreaker": {
        "FailureRateThreshold": 100,
        "SamplingDurationSeconds": 10,
        "MinimumThroughput": 5,
        "WaitDurationInOpenStateMilliseconds": 1000
      }
    }
  },
  "RateLimiting": {
    "PermitLimit": 10,
    "WindowSeconds": 60,
    "SegmentsPerWindow": 6,
    "QueueLimit": 0
  }
}
