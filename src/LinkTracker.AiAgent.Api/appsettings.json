{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kafka": {
    "Consumer": {
      "BootstrapServers": "localhost:9094,localhost:9095,localhost:9096",
      "Topic": "link.raw-updates",
      "GroupId": "linktracker-ai-agent",
      "DeadLetterTopic": "link.raw-updates-dlq",
      "RetryAttempts": 3,
      "RetryBackoffMilliseconds": 500
    },
    "Producer": {
      "BootstrapServers": "localhost:9094,localhost:9095,localhost:9096",
      "Topic": "link.processed-updates"
    }
  },
  "AiAgent": {
    "Filtering": {
      "StopWords": [
        "spam",
        "ads",
        "promo"
      ],
      "ExcludedAuthors": [
        "bot-user"
      ],
      "MinLength": 20
    },
    "Summarization": {
      "Threshold": 300
    },
    "Prioritization": {
      "HighKeywords": [
        "critical",
        "urgent",
        "breaking",
        "security"
      ],
      "LowKeywords": [
        "minor",
        "typo",
        "chore",
        "docs"
      ]
    },
    "Grouping": {
      "WindowMs": 30000
    }
  },
  "YandexAi": {
    "BaseUrl": "https://ai.api.cloud.yandex.net",
    "ModelId": "aliceai-llm",
    "TimeoutSeconds": 120
  }
}